OurAttributeHeading < UIWidget
  height: 32
  HorizontalSeparator
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
  Label
    id: title
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 17
    font: verdana-11px-monochrome
    color: #c0c0c0

OurAttributeRow < UIWidget
  height: 17
  // 15.10.2026 (Tobeto): pin a stat to the Skills tab
  UIWidget
    id: pin
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 10 10
    image-source: /game_skills/pin
    image-color: #6a6a6a
    visible: false
    phantom: false
  UIWidget
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 10 10
    visible: false
    phantom: true
  Label
    id: name
    anchors.left: parent.left
    anchors.right: next.left
    anchors.top: parent.top
    height: 17
    font: verdana-11px-monochrome
    color: #c0c0c0
    text-auto-resize: false
    phantom: true
  Label
    id: value
    anchors.right: parent.right
    anchors.top: parent.top
    width: 46
    height: 17
    text-align: right
    font: verdana-11px-monochrome
    phantom: true

MyStatRow < UIWidget
  height: 17
  SkillNameLabel
    id: name
  Label
    id: amount
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 17
    text-align: right
    width: 45
    height: 16
  Button
    id: add
    anchors.right: parent.right
    anchors.top: parent.top
    size: 15 15
    text: +
    text-offset: 0 1

SkillFirstWidget < UIWidget

SkillButton < UIButton
  height: 21
  margin-bottom: 2
  &onClick: onSkillButtonClick

SmallSkillButton < SkillButton
  height: 14

SkillNameLabel < GameLabel
  font: verdana-11px-monochrome
  anchors.left: parent.left
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  color: #C0C0C0

SkillValueLabel < GameLabel
  id: value
  font: verdana-11px-monochrome
  text-align: topright
  anchors.right: parent.right
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.left: prev.left
  color: #C0C0C0

ImageSkill < UIWidget
  id: icon
  size: 9 9
  width: 9
  margin-top: 13
  anchors.left: parent.left
  anchors.top: parent.top
  phantom: false

ImageAbsorb < UIWidget
  id: icon
  size: 9 9
  width: 9
  margin-top: 2
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

RedPercentPanel < ProgressBar
  id: percent
  background-color: red
  height: 5
  margin-top: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

SkillPercentPanel < ProgressBar
  id: percent
  background-color: green
  height: 5
  margin-top: 15
  margin-left: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

XpBoostButton < UIWidget
  height: 30
  HorizontalSeparator
    id: leftSeparator
    anchors.top: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: -23
    margin-left: 5
  UIWidget
    id: xpBoostButton
    image-source: /images/ui/button-storexp
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top : -7
    @onClick: |
      modules.game_store.toggle()
      g_game.sendRequestStorePremiumBoost()
    $pressed:
      image-source: /images/ui/button-storexp-pressed

MiniWindow
  id: skillWindow
  height: 150
  @onOpen: modules.game_skills.onMiniWindowOpen()
  @onClose: modules.game_skills.onMiniWindowClose()
  &save: true

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    image-source: /images/topbuttons/skills
    image-rect: 0 0 12 12
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Skills')
    color: #9d9d9dff

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    layout: verticalBox

    UIWidget
      id: myotsTabs
      height: 23
      Button
        anchors.left: parent.left
        anchors.top: parent.top
        width: 65
        height: 20
        padding: 0
        text: Skills
        @onClick: modules.game_skills.myotsTab(false)
      Button
        anchors.right: parent.right
        anchors.top: parent.top
        width: 82
        height: 20
        padding: 0
        text: Attributes
        @onClick: modules.game_skills.myotsTab(true)

    SkillButton
      margin-top: 5
      id: level
      SkillNameLabel
        !text: tr('Level')
      SkillValueLabel
      RedPercentPanel

    SkillButton
      id: experience
      height: 15
      SkillNameLabel
        !text: tr('Experience')
      SkillValueLabel

    SkillButton
      id: xpGainRate
      height: 15
      SkillNameLabel
        !text: tr('Experience Rate')
      SkillValueLabel
        color: #44ad25

    HorizontalSeparator
      id: ourSepPoints
      margin-top: 5
      margin-bottom: 5

    SkillButton
      id: myotsPoints
      height: 15
      SkillNameLabel
        text: Stat points
      SkillValueLabel

    UIWidget
      id: myots_str
      height: 17
      Label
        anchors.left: parent.left
        anchors.top: parent.top
        text-align: left
        width: 109
        height: 16
        text: Strength
      Label
        id: amount
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 18
        text-align: right
        width: 38
        height: 16
        text: 0
      Button
        id: add
        anchors.right: parent.right
        anchors.top: parent.top
        size: 15 15
        padding: 0
        text: +
        text-offset: 0 1
        !tooltip: modules.game_skills.myotsAddTip
        @onClick: modules.game_skills.myotsAllocate('str')

    UIWidget
      id: myots_dex
