SkillsSubMenuOption < ThickCheckBox
  text-offset: 18 1
  text-align: left
  color: white
  background-color: alpha
  font: verdana-11px-rounded
  padding: 3 6

  $hover:
    background-color: #ffffff1a

  $disabled:
    color: #c0c0c0ff

SkillsListOption < UIButton
  text-align: left
  color: white
  background-color: alpha
  font: verdana-11px-rounded
  padding: 3 6
  margin-left: 5

  $hover:
    background-color: #ffffff1a

  $disabled:
    color: #c0c0c0ff

SkillsListSubMenu < PopupMenu
  id: skillsListSubMenu
  width: 200

  SkillsListOption
    id: resetExperienceCounter
    !text: tr('Reset Experience Counter')

  HorizontalSeparator
    margin-top: 2
    margin-bottom: 3

  // 14.10.2026 (Tobeto): one list - ticking a position off hides its whole row (name and bar)
  SkillsSubMenuOption
    id: rowLevel
    !text: tr('Level')

  SkillsSubMenuOption
    id: rowExperience
    !text: tr('Experience')

  SkillsSubMenuOption
    id: rowHealth
    visible: false
    !text: tr('Hit Points')

  SkillsSubMenuOption
    id: rowMana
    visible: false
    !text: tr('Mana')

  SkillsSubMenuOption
    id: rowSoul
    visible: false
    !text: tr('Soul Points')

  SkillsSubMenuOption
