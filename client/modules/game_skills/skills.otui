    !text: tr('Fullness')

  SkillsSubMenuOption
    id: rowStamina
    !text: tr('Stamina')

  SkillsSubMenuOption
    id: rowOfflineTraining
    !text: tr('Offline Training')

  SkillsSubMenuOption
    id: rowMagic
    !text: tr('Magic Level')

  SkillsSubMenuOption
    id: rowFist
    !text: tr('Fist Fighting')

  SkillsSubMenuOption
    id: rowMelee
    !text: tr('Melee Fighting')

  SkillsSubMenuOption
    id: rowDistance
    !text: tr('Distance Fighting')

  SkillsSubMenuOption
    id: rowShielding
    !text: tr('Shielding')

  SkillsSubMenuOption
    id: rowFishing
    !text: tr('Fishing')

  // 16.10.2026 (Tobeto): Cooking can be hidden too
  SkillsSubMenuOption
    id: rowCooking
    !text: tr('Cooking')

