// 16.10.2026 (Tobeto): name, level and a difficulty bar; greyed out when the level is too
// low or the boss was defeated today (the cooldown is shown on top)
GFBossEntry < UIWidget
  height: 58
  background-color: #1c1c1cdd
  border-width: 1
  border-color: #3a3a3a
  focusable: true
  $focus:
    background-color: #3a2c14ee
    border-color: #d8a840
  $hover !focus:
    background-color: #262626ee
  UICreature
    id: creature
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 52 52
    phantom: true
  Label
    id: name
    anchors.left: creature.right
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 7 6 0 8
    font: verdana-11px-rounded
    color: #f0d080
    phantom: true
  Label
    id: info
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 3
    width: 70
    font: verdana-11px-monochrome
    color: #b0b0b0
    phantom: true
  Panel
    id: pips
    anchors.left: name.left
    anchors.top: info.bottom
    margin-top: 4
    size: 104 8
    phantom: true
  Label
    id: cooldown
    anchors.fill: parent
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    background-color: #000000a0
    phantom: true
    visible: false

GFMechanic < Label
  height: 20
  text-align: center
  font: verdana-11px-rounded
  color: #ff8a8a
  background-color: #2a1616
  border-width: 1
  border-color: #5a2a2a

GFInfoChip < UIWidget
  height: 24
  background-color: #222222
  border-width: 1
  border-color: #3e3e3e

GFRoleButton < UIButton
  size: 92 30
  font: verdana-11px-rounded
  color: #e0e0e0
  background-color: #262626
  border-width: 2
  border-color: #4a4a4a
  text-align: center
  $hover:
    background-color: #333333
  $checked:
    border-color: #f0c040
    background-color: #3c3014
  $disabled:
    color: #5a5a5a
    background-color: #181818
    border-color: #2a2a2a

GFSlot < UIWidget
  height: 26
  background-color: #161616dd
  border-width: 1
  border-color: #3a3a3a
  Label
    id: role
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    width: 52
    text-align: center
    font: verdana-11px-rounded
    phantom: true
  Label
    id: name
    anchors.left: role.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 70
    font: verdana-11px-monochrome
    color: #e0e0e0
    phantom: true
  Button
    id: kick
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    size: 62 18
    text: Remove
    visible: false

GFGroupRow < UIWidget
  height: 24
  background-color: #161616dd
  border-width: 1
  border-color: #3a3a3a
  Label
    id: text
    anchors.left: parent.left
    anchors.right: joinGroup.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 4
    font: verdana-11px-monochrome
    color: #d8d8d8
    phantom: true
  Button
    id: joinGroup
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    size: 64 18
    text: Join

GFRewardItem < UIItem
  size: 32 32
  virtual: true
  border-width: 1
  border-color: #3a3a3a
  background-color: #10101099

MainWindow
  id: groupFinder
  text: Group Finder - Daily Bosses
  size: 800 640
  @onEscape: modules.game_groupfinder.hide()

  // 16.10.2026 (Tobeto): the long description became a small info bar
  Panel
    id: intro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    background-color: #181818
    border-width: 1
    border-color: #3a3a3a
    Panel
      id: introInner
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      width: 600

  Panel
    id: list
    anchors.top: intro.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-bottom: 30
    width: 262
    layout:
      type: verticalBox
      spacing: 5

  Panel
    id: details
    anchors.top: intro.bottom
    anchors.left: list.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-left: 8
    margin-bottom: 30
    background-color: #141414cc
    border-width: 1
    border-color: #3a3a3a

    UIWidget
      id: bigBox
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 10 0 0 10
      size: 80 80
      background-color: #1c1c1c
      border-width: 1
      border-color: #303030
    UICreature
      id: bigCreature
      anchors.centerIn: bigBox
      size: 76 76
      phantom: true
    Label
      id: bossName
      anchors.top: bigBox.top
      anchors.left: bigBox.right
      anchors.right: parent.right
      margin-top: 8
      margin-left: 12
      font: verdana-11px-rounded
      color: #f0d080
    Label
      id: bossStats
      anchors.top: bossName.bottom
      anchors.left: bossName.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-monochrome
      color: #d0d0d0
    Label
      id: diffLabel
      anchors.top: bossStats.bottom
      anchors.left: bossName.left
      margin-top: 8
      text: Difficulty
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #a0a0a0
    Panel
      id: bigPips
      anchors.verticalCenter: diffLabel.verticalCenter
      anchors.left: diffLabel.right
      margin-left: 8
      size: 160 10

    Label
      id: mechTitle
      anchors.top: bigBox.bottom
      anchors.left: parent.left
      margin: 12 10 0 10
      font: verdana-11px-rounded
      color: #f0d080
      text: Mechanics
      text-auto-resize: true
    Panel
      id: mechanics
      anchors.top: mechTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5 10 0 10
      height: 22
      layout:
        type: horizontalBox
        spacing: 5
        fit-children: false

    Label
      id: rewardsTitle
      anchors.top: mechanics.bottom
      anchors.left: parent.left
      margin: 8 10 0 10
      font: verdana-11px-rounded
      color: #f0d080
      text: Rewards
      text-auto-resize: true
    Panel
      id: rewards
      anchors.top: rewardsTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5 10 0 10
      height: 38
      layout:
        type: grid
        cell-size: 32 32
        cell-spacing: 4
        flow: true

    Panel
      id: actions
      anchors.top: rewards.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 12 10 0 10
      height: 30
      Button
        id: joinButton
        anchors.left: parent.left
        anchors.top: parent.top
        size: 150 28
        text: Quick join
        tooltip: Join the oldest group that has a free place for your role (or start a new one).
        @onClick: modules.game_groupfinder.join()
      Button
        id: createButton
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        size: 150 28
        text: Create group
        tooltip: Make a new group of your own (you can set a password).
        @onClick: modules.game_groupfinder.create()
      Button
        id: partyButton
        anchors.right: parent.right
        anchors.top: parent.top
        size: 150 28
        text: Join as party
        tooltip: Party leader only: queue your whole party (max 4 players) as one closed group.
        @onClick: modules.game_groupfinder.joinParty()

    Label
      id: groupsTitle
      anchors.top: actions.bottom
      anchors.left: parent.left
      margin: 12 10 0 10
      font: verdana-11px-rounded
      color: #f0d080
      text: Groups waiting for this boss
      text-auto-resize: true
    Panel
      id: groups
      anchors.top: groupsTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5 10 0 10
      height: 104
      layout:
        type: verticalBox
        spacing: 2

    Label
      id: groupTitle
      anchors.top: groups.bottom
      anchors.left: parent.left
      margin: 10 10 0 10
      font: verdana-11px-rounded
      color: #f0d080
      text: Your group
      text-auto-resize: true
    Label
      id: groupState
      anchors.top: groupTitle.top
      anchors.left: groupTitle.right
      anchors.right: parent.right
      margin-left: 8
      margin-right: 10
      font: verdana-11px-monochrome
      color: #b0b0b0
    Panel
      id: slots
      anchors.top: groupTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5 10 0 10
      height: 112
      layout:
        type: verticalBox
        spacing: 2

  Button
    id: startButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 110 22
    text: Start
    @onClick: modules.game_groupfinder.start()
  Button
    id: leaveButton
    anchors.bottom: parent.bottom
    anchors.right: startButton.left
    margin-right: 6
    size: 110 22
    text: Leave group
    @onClick: modules.game_groupfinder.leave()
  Button
    id: roleButton
    anchors.bottom: parent.bottom
    anchors.right: leaveButton.left
    margin-right: 6
    size: 110 22
    text: Change role
    tooltip: Change your role in the group (1 tank and 1 healer per group).
    @onClick: modules.game_groupfinder.changeRole()
  Button
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 80 22
    text: Close
    @onClick: modules.game_groupfinder.hide()
  Label
    id: footer
    anchors.bottom: parent.bottom
    anchors.left: closeButton.right
    anchors.right: roleButton.left
    margin: 0 8 4 8
    font: verdana-11px-monochrome
    color: #9a9a9a
    text: Rewards go to the reward chest in any town temple.

// 16.10.2026 (Tobeto): the role (and an optional password) is asked when you create or join
GFRoleDialog < MainWindow
  size: 340 158
  text: Choose your role
  GFRoleButton
    id: tank
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 6
    text: Tank
  GFRoleButton
    id: healer
    anchors.top: tank.top
    anchors.horizontalCenter: parent.horizontalCenter
    text: Healer
  GFRoleButton
    id: dps
    anchors.top: tank.top
    anchors.right: parent.right
    text: DPS
  Label
    id: pwLabel
    anchors.top: tank.bottom
    anchors.left: parent.left
    margin-top: 16
    font: verdana-11px-monochrome
    color: #c0c0c0
    text: Password (optional):
    text-auto-resize: true
  TextEdit
    id: password
    anchors.verticalCenter: pwLabel.verticalCenter
    anchors.left: pwLabel.right
    anchors.right: parent.right
    margin-left: 8
    height: 20
    max-length: 16
  Label
    id: note
    anchors.top: pwLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 14
    text-align: center
    font: verdana-11px-monochrome
    color: #ff9a7a
  Button
    id: cancel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 80 22
    text: Cancel
  Button
    id: ok
    anchors.bottom: parent.bottom
    anchors.right: cancel.left
    margin-right: 6
    size: 80 22
    text: OK
