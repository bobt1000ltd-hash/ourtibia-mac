Panel
  id: itemDetailsPage
  anchors.top: tabs.bottom
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: footer.top
  margin-top: 8
  visible: false
  // OurTibia (18.10.2026, Tobeto): picture, name and main stats in a panel without a title,
  // above "Item details" and as wide as the whole wiki (aligned with the panels below)
  WikiPlainPanel
    id: summary
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 56
    UIItem
      id: icon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      size: 40 40
      virtual: true
      phantom: true
    Label
      id: name
      anchors.left: icon.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 8
      margin-left: 8
      margin-right: 6
      height: 42
      text-wrap: true
      font: verdana-11px-monochrome
  // 16.10.2026 (Tobeto): "Item details", "Buy from" and "Sell to" in the "Configure" panel style
  MiniPanel
    id: base
    anchors.top: summary.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 6
    width: 198
    padding: 0
    text: Item details
    Button
      id: trackButton
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 6
      margin-right: 16
      // 17.10.2026 (Tobeto): the same size as the Close button
      height: 20
      text: Track drop
      !tooltip: tr('Add this item to the Drop Tracker (Analyzer)')
    Button
      id: profButton
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: trackButton.top
      margin: 0 16 4 6
      height: 20
      text: Show proficiency
      visible: false
    Label
      id: stats
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: profButton.top
      margin: 8
      margin-top: 30
      text-wrap: true
      font: verdana-11px-monochrome
  // OurTibia (18.10.2026, Tobeto): the drop / quest table is a panel titled "Drop" or "Quest";
  // the toggle button below the title names the other table, the sorting stays on the right
  MiniPanel
    id: obtaining
    anchors.left: base.right
    anchors.right: parent.right
    anchors.top: summary.bottom
    margin-left: 6
    margin-top: 6
    height: 268
    text: Drop
    Button
      id: sourceToggle
      anchors.verticalCenter: sourceOrder.verticalCenter
      anchors.left: parent.left
      size: 90 20
      text: Quest
      @onClick: modules.game_myotswiki.toggleSourceTab()
    ComboBox
      id: sourceFilter
      text-offset: -15 0
      anchors.top: parent.top
      anchors.right: sourceSort.left
      margin-top: 1
      margin-right: 5
      width: 106
    ComboBox
      id: sourceSort
      text-offset: -15 0
      anchors.top: parent.top
      anchors.right: sourceOrder.left
      margin-top: 1
      margin-right: 5
      width: 106
    ComboBox
      id: sourceOrder
      text-offset: -15 0
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 1
      width: 106
    ScrollablePanel
      id: sources
      anchors.top: sourceOrder.bottom
      anchors.left: parent.left
      anchors.right: sourceScroll.left
      anchors.bottom: parent.bottom
      margin: 5 4 0 0
      vertical-scrollbar: sourceScroll
      layout:
        type: grid
        cell-size: 200 51
        cell-spacing: 3
        num-columns: 3
    VerticalScrollBar
      id: sourceScroll
      anchors.top: sourceOrder.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      step: 54
      pixels-scroll: true
  MiniPanel
    id: buyFrame
    anchors.top: obtaining.bottom
    anchors.left: obtaining.left
    anchors.bottom: parent.bottom
    margin-top: 8
    width: 318
    padding: 0
    text: Buy from
  MiniPanel
    id: sellFrame
    anchors.top: obtaining.bottom
    anchors.left: buyFrame.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-left: 6
    padding: 0
    text: Sell to
  ScrollablePanel
    id: buy
    anchors.top: buyFrame.top
    anchors.left: buyFrame.left
    anchors.right: buyScroll.left
    anchors.bottom: buyFrame.bottom
    margin: 25 2 6 6
    vertical-scrollbar: buyScroll
    layout:
      type: verticalBox
      spacing: 4
  VerticalScrollBar
    id: buyScroll
    step: 48
    anchors.top: buyFrame.top
    anchors.right: buyFrame.right
    anchors.bottom: buyFrame.bottom
    margin: 25 6 6 0
    pixels-scroll: true
  ScrollablePanel
    id: sell
    anchors.top: sellFrame.top
    anchors.left: sellFrame.left
    anchors.right: sellScroll.left
    anchors.bottom: sellFrame.bottom
    margin: 25 2 6 6
    vertical-scrollbar: sellScroll
    layout:
      type: verticalBox
      spacing: 4
  VerticalScrollBar
    id: sellScroll
    step: 48
    anchors.top: sellFrame.top
    anchors.right: sellFrame.right
    anchors.bottom: sellFrame.bottom
    margin: 25 6 6 0
    pixels-scroll: true
