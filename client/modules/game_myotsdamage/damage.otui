DmgTab < UIButton
  height: 28
  width: 120
  text-align: center
  text-offset: 0 2
  font: verdana-11px-rounded
  color: #bdbdbd
  background-color: #262626
  border-width: 1
  border-color: #3c3c3c
  $hover:
    color: #ffffff
    border-color: #6a6a6a
  $on:
    background-color: #3a3220
    border-color: #c8a040
    color: #ffd35a

DmgStat < UIWidget
  size: 81 40
  background-color: #1b1b1b
  border-width: 1
  border-color: #333333
  Label
    id: caption
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 12
    text-align: center
    font: verdana-11px-rounded
    color: #8f8f8f
    phantom: true
  Label
    id: value
    anchors.top: caption.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 16
    text-align: center
    font: verdana-11px-rounded
    color: #ffd35a
    phantom: true

DmgRange < UIWidget
  size: 118 40
  background-color: #141414
  border-width: 1
  border-color: #2e2e2e
  phantom: true
  Label
    id: caption
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 12
    text-align: center
    font: verdana-11px-rounded
    color: #8f8f8f
    phantom: true
  Label
    id: value
    anchors.top: caption.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 16
    text-align: center
    font: verdana-11px-rounded
    color: #ffffff
    phantom: true

DmgCard < UIWidget
  height: 64
  background-color: #222222
  border-width: 1
  border-color: #3a3a3a
  $hover:
    border-color: #6b5626
    background-color: #262420
  UIWidget
    id: artBox
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    size: 44 44
    background-color: #161616
    border-width: 1
    border-color: #303030
    phantom: true
  UIWidget
    id: spellIcon
    anchors.centerIn: artBox
    size: 32 32
    phantom: true
  UIItem
    id: runeIcon
    anchors.centerIn: artBox
    size: 32 32
    virtual: true
    phantom: true
  Label
    id: name
    anchors.top: artBox.top
    anchors.left: artBox.right
    margin: 1 0 0 10
    width: 190
    height: 14
    font: verdana-11px-rounded
    color: #f0f0f0
    phantom: true
  Label
    id: words
    anchors.top: name.bottom
    anchors.left: name.left
    margin-top: 2
    width: 190
    height: 13
    font: verdana-11px-rounded
    color: #9a9a9a
    phantom: true
  Label
    id: element
    anchors.top: words.bottom
    anchors.left: name.left
    margin-top: 2
    text-auto-resize: true
    padding: 0 5 0 5
    font: verdana-11px-monochrome
    color: #101010
    background-color: #d0d0d0
    phantom: true
  DmgRange
    id: crit
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
  DmgRange
    id: normal
    anchors.right: crit.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6

MainWindow
  id: myotsDamage
  text: Damage Calculator
  size: 640 620
  @onEscape: modules.game_myotsdamage.hide()

  UIWidget
    id: stats
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    layout:
      type: horizontalBox
      spacing: 5

  UIWidget
    id: weaponCard
    anchors.top: stats.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 96
    background-color: #24201a
    border-width: 1
    border-color: #c8a040
    Label
      id: weaponHeader
      anchors.top: parent.top
      anchors.left: parent.left
      margin: 6 0 0 10
      text-auto-resize: true
      font: verdana-11px-rounded
      color: #c8a040
      text: WEAPON (AUTO-ATTACK)
    UIWidget
      id: weaponArt
      anchors.top: weaponHeader.bottom
      anchors.left: parent.left
      margin: 6 0 0 10
      size: 58 58
      background-color: #161616
      border-width: 1
      border-color: #3a3220
      phantom: true
    UIItem
      id: weaponIcon
      anchors.centerIn: weaponArt
      size: 48 48
      virtual: true
      phantom: true
    Label
      id: weaponName
      anchors.top: weaponArt.top
      anchors.left: weaponArt.right
      margin: 4 0 0 12
      width: 200
      height: 16
      font: Verdana Bold-11px
      color: #ffd35a
    Label
      id: weaponInfo
      anchors.top: weaponName.bottom
      anchors.left: weaponName.left
      margin-top: 3
      width: 200
      height: 14
      font: verdana-11px-rounded
      color: #bdbdbd
    Label
      id: weaponElement
      anchors.top: weaponInfo.bottom
      anchors.left: weaponName.left
      margin-top: 3
      width: 200
      height: 14
      font: verdana-11px-rounded
      color: #9a9a9a
    DmgRange
      id: wCrit
      anchors.right: parent.right
      anchors.verticalCenter: weaponArt.verticalCenter
      margin-right: 10
      width: 130
    DmgRange
      id: wNormal
      anchors.right: wCrit.left
      anchors.verticalCenter: weaponArt.verticalCenter
      margin-right: 6
      width: 130

  ComboBox
    id: sort
    anchors.top: weaponCard.bottom
    anchors.right: parent.right
    margin-top: 13
    width: 150
    text-align: center
    !tooltip: tr('Sort the list')

  UIWidget
    id: tabs
    anchors.top: weaponCard.bottom
    anchors.left: parent.left
    anchors.right: sort.left
    margin-right: 8
    margin-top: 10
    height: 28
    layout:
      type: horizontalBox
      spacing: 4

  ScrollablePanel
    id: list
    anchors.top: tabs.bottom
    anchors.left: parent.left
    anchors.right: listScroll.left
    anchors.bottom: footer.top
    margin: 6 2 6 0
    vertical-scrollbar: listScroll
    background-color: #181818
    border-width: 1
    border-color: #3a3a3a
    padding: 6
    layout:
      type: verticalBox
      spacing: 5

  VerticalScrollBar
    id: listScroll
    anchors.top: tabs.bottom
    anchors.bottom: footer.top
    anchors.right: parent.right
    margin-top: 6
    margin-bottom: 6
    step: 69
    pixels-scroll: true

  Label
    id: footer
    anchors.left: parent.left
    anchors.right: refresh.left
    anchors.bottom: parent.bottom
    margin-right: 8
    height: 30
    text-wrap: true
    font: verdana-11px-rounded
    color: #7f7f7f

  Button
    id: refresh
    anchors.right: close.left
    anchors.bottom: parent.bottom
    margin-right: 4
    size: 70 22
    text: Refresh
    @onClick: modules.game_myotsdamage.request()

  Button
    id: close
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 64 22
    text: Close
    @onClick: modules.game_myotsdamage.hide()
