HudWindow < MiniWindow
  &save: true
  height: 180
  width: 180
  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-left: 5
    margin-top: 1
    width: 118
    height: 14
    font: verdana-11px-monochrome
  MiniWindowContents
    padding-left: 5
    padding-right: 5
    padding-top: 3
    padding-bottom: 3
    layout:
      type: verticalBox
      spacing: 3

HudLabel < Label
  height: 17
  font: verdana-11px-monochrome

HudButton < Button
  height: 23
  width: 166
  font: verdana-11px-monochrome

HudCheck < CheckBox
  height: 19
  font: verdana-11px-monochrome

KillEntry < UIWidget
  height: 50
  focusable: false
  UICreature
    id: outfit
    phantom: true
    anchors.left: parent.left
    anchors.top: parent.top
    size: 40 40
  Label
    id: name
    phantom: true
    anchors.left: outfit.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    margin-right: 2
    height: 15
    font: verdana-11px-monochrome
  Panel
    id: stars
    phantom: true
    anchors.left: outfit.right
    anchors.top: name.bottom
    margin-left: 6
    size: 80 10
    layout:
      type: horizontalBox
      spacing: 1
  LifeProgressBar
    id: killProgress
    phantom: true
    anchors.left: outfit.right
    anchors.right: parent.right
    anchors.top: stars.bottom
    margin-top: 3
    margin-right: 2
    margin-left: 6
    height: 16
    background-color: #00a83a
    border: 1 #182018
    font: verdana-11px-rounded
    color: #ffffff
    text-offset: 0 -1
    text-align: center
  Label
    id: killCount
    phantom: true
    anchors.left: outfit.right
    anchors.top: killProgress.bottom
    anchors.right: parent.right
    height: 0
    visible: false

KillStar < UIWidget
  size: 9 10
  phantom: true

HudItem < UIItem
  size: 32 32
  virtual: true
  image-source: /images/ui/item

HudBag < HudButton
  padding: 0
  height: 34
  text-offset: 35 0
  text-align: left
  $pressed:
    text-offset: 36 1
  UIItem
    id: itemIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 32 32
    image-source: /images/ui/item
    virtual: true
    phantom: true
  Button
    id: remove
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    size: 20 20
    padding: 0
    text: X
    visible: false

HudItemGrid < Panel
  height: 104
  layout:
    type: grid
    cell-size: 38 32
    num-columns: 4
    cell-spacing: 2

HudDropSlot < Button
  size: 32 32
  image-source: /images/ui/item
  UIItem
    id: icon
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    virtual: true
    phantom: true

DailyOffer < Panel
  size: 211 214
  image-source: /images/ui/panel_flat
  image-border: 1
  UICreature
    id: outfit
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 5
    margin-top: 15
    size: 60 60
  Label
    id: name
    anchors.left: outfit.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 10
    margin-left: 5
    height: 34
    text-wrap: true
    font: verdana-11px-monochrome
  Label
    id: progress
    anchors.left: outfit.right
    anchors.top: name.bottom
    anchors.right: parent.right
    margin-left: 5
    height: 28
    font: verdana-11px-monochrome
  Label
    id: rewards
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: outfit.bottom
    margin-left: 9
    margin-top: 13
    height: 95
    font: verdana-11px-monochrome
  Button
    id: accept
    text: Accept Task
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 5
    height: 25

LootHeader < CheckBox
  height: 17
  font: verdana-11px-rounded
  color: #e8e8e8
  margin-top: 4

LootMiniX < UIButton
  size: 11 11
  text: x
  font: verdana-11px-monochrome
  color: #ffffff
  background-color: #3a1010dd
  border-width: 1
  border-color: #000000
  text-offset: 0 -2
  visible: false
  $hover:
    background-color: #902020ee

LootSmallButton < Button
  height: 17
  font: verdana-11px-monochrome

LootBagRow < UIWidget
  height: 36
  UIItem
    id: itemIcon
    anchors.left: parent.left
    anchors.top: parent.top
    size: 34 34
    image-source: /images/ui/item
    virtual: true
  LootMiniX
    id: remove
    anchors.top: itemIcon.top
    anchors.right: itemIcon.right
  Panel
    id: icons
    anchors.left: itemIcon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 5
    height: 16
    layout:
      type: grid
      cell-size: 16 16
      cell-spacing: 2
      num-columns: 7
      flow: true
  LootSmallButton
    id: addContainer
    anchors.left: itemIcon.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 5
    text: [+] Container
  LootSmallButton
    id: addItem
    anchors.left: itemIcon.right
    anchors.right: parent.right
    anchors.bottom: addContainer.top
    margin-left: 5
    margin-bottom: 1
    text: [+] Add an item
    visible: false

LootPages < UIWidget
  height: 20

LootPageButton < Button
  size: 18 18
  font: verdana-11px-monochrome
  text-align: center
  text-offset: 0 0
  // 12.10.2026: every property of $on also set here - otherwise it stays after setOn(false)
  // (the old green image-color stayed on every page button that was ever chosen)
  color: #dfdfdf
  image-color: #ffffff
  $pressed:
    text-offset: 0 0
  $on:
    text-offset: 0 0
    color: #40ff40
    image-color: #60c060

LootSlot < UIButton
  size: 34 34
  image-source: /images/ui/item
  UIItem
    id: icon
    anchors.fill: parent
    virtual: true
    phantom: true
  Label
    id: plus
    anchors.centerIn: parent
    text: +
    font: verdana-11px-rounded
    color: #8a8a8a
    phantom: true
  LootMiniX
    id: remove
    anchors.top: parent.top
    anchors.right: parent.right

LootSlotGrid < Panel
  height: 74
  layout:
    type: grid
    cell-size: 34 34
    num-columns: 4
    cell-spacing: 4
    flow: true

// 08.10.2026: compact autoloot row - option checkbox on the left, [i] button,
// destination container slot on the right (click it to choose the container)
LootCatRow < UIWidget
  height: 36
  UIItem
    id: itemIcon
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    size: 34 34
    image-source: /images/ui/item
    virtual: true
  Label
    id: plus
    anchors.centerIn: itemIcon
    text: +
    font: verdana-11px-rounded
    color: #8a8a8a
    phantom: true
  LootMiniX
    id: remove
    anchors.top: itemIcon.top
    anchors.right: itemIcon.right
  Button
    id: info
    size: 16 16
    text: i
    anchors.right: itemIcon.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    visible: false
  LootHeader
    id: check
    anchors.left: parent.left
    anchors.right: itemIcon.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 22
    margin-top: 0
    height: 30
    text-wrap: true

TaskRows < UIWidget
  height: 10
  phantom: true
  layout:
    type: verticalBox
    fit-children: true

TaskHeader < Label
  height: 16
  font: verdana-11px-monochrome
  color: #f0c060
  text-offset: 2 2

TaskEntry < UIWidget
  height: 36
  UICreature
    id: outfit
    phantom: true
    anchors.left: parent.left
    anchors.top: parent.top
    size: 34 34
  Label
    id: name
    phantom: true
    anchors.left: outfit.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 5
    margin-top: 2
    height: 14
    font: verdana-11px-monochrome
    color: #e8e8e8
    text-auto-resize: false
  LifeProgressBar
    id: progress
    phantom: true
    anchors.left: outfit.right
    anchors.right: parent.right
    anchors.top: name.bottom
    margin-top: 3
    margin-right: 2
    margin-left: 5
    height: 16
    background-color: #c08a20
    border: 1 #182018
    font: verdana-11px-rounded
    color: #ffffff
    text-offset: 0 -1
    text-align: center
