TalentNode < UIWidget
  size: 44 44
  background-color: #151515
  border-width: 2
  border-color: #4a4a4a
  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 32 32
    phantom: true
  Label
    id: rank
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 1
    margin-bottom: 0
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #ffffff
    background-color: #000000c0
    phantom: true

TalentRow < UIWidget
  height: 52
  Label
    id: need
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 26
    text-align: center
    font: verdana-11px-monochrome
    color: #8a8a8a
  Panel
    id: nodes
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 120
    layout:
      type: horizontalBox
      spacing: 28

TalentTree < UIWidget
  // 15.10.2026 (Tobeto): no gap between the header and the first talents
  size: 236 432
  background-color: #1a1a1aee
  border-width: 1
  border-color: #505050
  UIWidget
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 44
    background-color: #402020
    UIWidget
      id: emblem
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      size: 32 32
      phantom: true
    Label
      id: name
      anchors.left: emblem.right
      anchors.top: parent.top
      margin-left: 8
      margin-top: 5
      font: verdana-11px-rounded
      text-auto-resize: true
      color: #ffffff
    Label
      id: kind
      anchors.left: emblem.right
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-bottom: 5
      font: verdana-11px-monochrome
      text-auto-resize: true
      color: #d0d0d0
    Label
      id: points
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      font: verdana-11px-rounded
      text-auto-resize: true
      color: #ffd35a
  // 15.10.2026 (Tobeto): the tree sits at the bottom of its column - the same space between the
  // progress bar and the border, no empty gap above the bar
  Panel
    id: rows
    anchors.bottom: capLine.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 270
    layout:
      type: verticalBox
      spacing: 2
  UIWidget
    id: capLine
    anchors.bottom: cap.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 2 10
    background-color: #806020
  UIWidget
    id: cap
    anchors.bottom: capName.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 64 64
  Label
    id: capName
    anchors.bottom: bar.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8
    height: 16
    text-align: center
    font: verdana-11px-rounded
    color: #f0d080
  UIWidget
    id: bar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 0 8 8 8
    height: 8
    background-color: #2a2a2a
    border-width: 1
    border-color: #555555
    UIWidget
      id: fill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      background-color: #d0a030
      phantom: true

MainWindow
  id: myotsTalents
  text: Talent Trees
  // 14.10.2026 (Tobeto): no title line and no right panel - the points are in the bottom bar
  size: 760 508
  @onEscape: modules.game_myotstalents.hide()
  Panel
    id: trees
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 724 432
    layout:
      type: horizontalBox
      spacing: 8
  // 15.10.2026 (Tobeto): points, balance and buttons centred between the trees and the window bottom
  Panel
    id: bottom
    anchors.top: trees.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 10
    Label
      id: free
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 170
      height: 22
      text-align: center
      font: verdana-11px-rounded
      color: #ffd35a
      background-color: #111111
      border-width: 1
      border-color: #6a5420
    Label
      id: gold
      anchors.left: free.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      width: 120
      height: 22
      text-align: center
      color: #f0d060
      background-color: #111111
      border-width: 1
      border-color: #4a4a4a
    Label
      id: status
      anchors.left: gold.right
      anchors.right: reset.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      margin-right: 8
      color: #ff9a7a
    Button
      id: reset
      anchors.right: close.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      width: 150
      text: Reset
      @onClick: modules.game_myotstalents.reset()
    Button
      id: close
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 64
      text: Close
      @onClick: modules.game_myotstalents.hide()
