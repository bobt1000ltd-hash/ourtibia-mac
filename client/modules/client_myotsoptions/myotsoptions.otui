MyotsOptionsTab < UIButton
  height: 46
  text-align: bottom
  text-offset: 0 -2
  font: verdana-11px-rounded
  color: #c8c8c8
  background-color: alpha
  $hover:
    color: #ffffff
    background-color: #ffffff12
  $on:
    color: #8fd0ff
    background-color: #ffffff18
  UIWidget
    id: icon
    size: 26 26
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    image-smooth: true
    phantom: true

MainWindow
  id: myotsOptions
  !text: tr('Options')
  size: 400 420
  @onEscape: modules.client_myotsoptions.hide()

  Panel
    id: tabList
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: okButton.top
    width: 74
    margin-bottom: 8
    background-color: #00000040
    border-width: 1
    border-color: #00000080
    layout:
      type: verticalBox
      spacing: 4

  Panel
    id: content
    anchors.top: parent.top
    anchors.left: tabList.right
    anchors.right: parent.right
    anchors.bottom: okButton.top
    margin-left: 10
    margin-bottom: 8
    layout:
      type: verticalBox
      spacing: 5

  Button
    id: advancedButton
    !text: tr('Advanced...')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 90
    @onClick: modules.client_myotsoptions.hide(); modules.client_options.show()

  Button
    id: okButton
    !text: tr('Ok')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 64
    @onClick: modules.client_myotsoptions.hide()
